generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  name                 String
  email                String           @unique
  password             String
  role                 UserRole         @default(USER)
  createdAt            DateTime         @default(now())
  avatarUrl            String?
  status               UserStatus       @default(ACTIVE)
  updatedAt            DateTime         @updatedAt
  creatorConversations Conversation[]   @relation("CreatorConversations")
  userConversations    Conversation[]   @relation("UserConversations")
  earnings             CreatorEarning[]
  creatorProfile       CreatorProfile?
  receivedMessages     Message[]        @relation("ReceivedMessages")
  sentMessages         Message[]        @relation("SentMessages")
  payments             Payment[]
  chatMessages         ChatMessage[]    @relation("ChatMessageSender")

  @@index([email])
  @@index([role])
}

model CreatorProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  username     String        @unique
  bio          String?
  category     String?
  replyPrice   Decimal       @db.Decimal(10, 2)
  currency     String        @default("USD")
  status       CreatorStatus @default(PENDING)
  profileImage String?
  totalReplies Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([username])
  @@index([status])
}

model Conversation {
  id        String        @id @default(uuid())
  userId    String
  creatorId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  creator   User          @relation("CreatorConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  user      User          @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

model Message {
  id               String         @id @default(uuid())
  senderId         String
  creatorId        String
  creatorProfileId String
  content          String
  status           MessageStatus  @default(PENDING_PAYMENT)
  expiresAt        DateTime?
  repliedAt        DateTime?
  declinedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  replyContent     String?
  creator          User           @relation("ReceivedMessages", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  payment          Payment?

  @@index([senderId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
  @@index([expiresAt])
}

model ChatMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  messageId             String        @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  message               Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model CreatorEarning {
  id          String   @id @default(uuid())
  creatorId   String
  messageId   String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  platformFee Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CreatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MessageStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_REPLY
  REPLIED
  DECLINED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}
