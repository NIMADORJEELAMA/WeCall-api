generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String               @id @default(uuid())
  name                        String
  email                       String               @unique
  password                    String
  role                        UserRole             @default(USER)
  createdAt                   DateTime             @default(now())
  avatarUrl                   String?
  status                      UserStatus           @default(ACTIVE)
  updatedAt                   DateTime             @updatedAt
  creatorConversations        Conversation[]       @relation("CreatorConversations")
  userConversations           Conversation[]       @relation("UserConversations")
  earnings                    CreatorEarning[]
  creatorProfile              CreatorProfile?
  receivedMessages            Message[]            @relation("ReceivedMessages")
  sentMessages                Message[]            @relation("SentMessages")
  payments                    Payment[]
  chatMessages                ChatMessage[]        @relation("ChatMessageSender")
  replyAuthorizationsBought   ReplyAuthorization[] @relation("ReplyAuthorizationUser")
  replyAuthorizationsReceived ReplyAuthorization[] @relation("ReplyAuthorizationCreator")

  @@index([email])
  @@index([role])
}

model CreatorProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  username     String        @unique
  bio          String?
  category     String?
  replyPrice   Decimal       @db.Decimal(10, 2)
  currency     String        @default("USD")
  status       CreatorStatus @default(PENDING)
  profileImage String?
  totalReplies Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([username])
  @@index([status])
}

model Conversation {
  id                  String               @id @default(uuid())
  userId              String
  creatorId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  messages            ChatMessage[]
  creator             User                 @relation("CreatorConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  user                User                 @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  replyAuthorizations ReplyAuthorization[]

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

model Message {
  id               String         @id @default(uuid())
  senderId         String
  creatorId        String
  creatorProfileId String
  content          String
  status           MessageStatus  @default(PENDING_PAYMENT)
  expiresAt        DateTime?
  repliedAt        DateTime?
  declinedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  replyContent     String?
  creator          User           @relation("ReceivedMessages", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  payment          Payment?
  ChatMessage      ChatMessage[]

  @@index([senderId])
  @@index([creatorId])
  @@index([creatorProfileId])
  @@index([status])
  @@index([expiresAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  paidMessageId    String?
  replyToMessageId String?

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyToMessage ChatMessage?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("MessageReplies")
  paidMessage    Message?      @relation(fields: [paidMessageId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([replyToMessageId])
  @@index([paidMessageId])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  messageId             String        @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  message               Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model CreatorEarning {
  id          String   @id @default(uuid())
  creatorId   String
  messageId   String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  platformFee Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

enum ReplyAuthorizationStatus {
  PENDING
  PROCESSING
  AVAILABLE
  USED
  FAILED
  EXPIRED
  REFUNDED
}

model ReplyAuthorization {
  id                    String                   @id @default(uuid())
  conversationId        String
  userId                String
  creatorId             String
  amount                Decimal                  @db.Decimal(10, 2)
  currency              String                   @default("usd")
  status                ReplyAuthorizationStatus @default(PENDING)
  stripePaymentIntentId String?                  @unique
  createdAt             DateTime                 @default(now())
  usedAt                DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ReplyAuthorizationUser", fields: [userId], references: [id])
  creator      User         @relation("ReplyAuthorizationCreator", fields: [creatorId], references: [id])

  @@index([conversationId, status])
  @@index([creatorId, status])
  @@index([userId, status])
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CreatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MessageStatus {
  PENDING_PAYMENT
  AWAITING_REPLY
  REPLIED
  DECLINED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}
